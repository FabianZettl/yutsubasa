[Unit]
Description=Sunshine gaming session - automatic quality step-down
After=sunshine-gaming.service
BindsTo=sunshine-gaming.service

[Service]
Type=simple
ExecStart=/usr/local/bin/gaming-launcher _adapter-loop
Restart=on-failure
RestartSec=5

[Install]
# Not enabled by default. Turn on with:  gaming-launcher quality --auto on
WantedBy=sunshine-gaming.service
