document.getElementById('gfilter').addEventListener('input',()=>{{
 clearTimeout(window._gf); window._gf=setTimeout(load,200);
}});
load(); setInterval(load,8000);
</script></body></html>"""


class H(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def _send(self, code, body, ctype="text/plain; charset=utf-8"):
        b = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)

    def _auth(self, payload):
        tok = conf("token", "")
        if conf("bind", "loopback") != "lan":
            return True
        return bool(tok) and payload.get("token") == tok

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            self._send(200, PAGE.format(token=conf("token", "")), "text/html; charset=utf-8")
        elif self.path == "/api/status":
            self._send(200, status_text())
        elif self.path == "/api/games":
            self._send(200, json.dumps(library_games()), "application/json")
        elif self.path == "/api/clients":
            self._send(200, json.dumps(clients_list()), "application/json")
        else:
            self._send(404, "not found")

    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0) or 0)
        try:
            payload = json.loads(self.rfile.read(n) or b"{}")
        except ValueError:
            payload = {}
        if not self._auth(payload):
            self._send(403, "forbidden (bad token)"); return
        if self.path == "/api/add-game":
            target = str(payload.get("id", "")).strip()
            if not target:
                appid = str(payload.get("appid", "")).strip()
                target = f"steam:{appid}" if appid.isdigit() else ""
            name = str(payload.get("name", "")).strip() or target
            if not re.match(r"^(steam:\d+|lutris:[\w.-]+|heroic:[\w:.@-]+)$", target):
                self._send(400, "bad target"); return
            args = [LAUNCHER, "add-game", name, target]
            if payload.get("direct"):
                args.append("--direct")
            if payload.get("gamescope"):
                args.append("--gamescope")
            self._send(200, sh(*args, timeout=90))
        elif self.path == "/api/client":
            name = str(payload.get("name", "")).strip()
            if not name:
                self._send(400, "bad name"); return
            if not payload.get("enabled", True):
                self._send(200, sh(LAUNCHER, "clients", "off", name)); return
            factor = str(payload.get("factor", "1")).strip()
            if not re.match(r"^[0-9]+(\.[0-9]+)?$", factor):
                self._send(400, "bad factor"); return
            args = [LAUNCHER, "clients", "set", name, factor]
            match = str(payload.get("match", "")).strip()
            if match:
                args += [p for p in re.split(r"[,\s]+", match) if p]
            self._send(200, sh(*args))
        elif self.path == "/api/reload":
            self._send(200, sh("systemctl", "--user", "restart",
                               "sunshine-gaming.service", timeout=60))
        else:
            self._send(404, "not found")

    def log_message(self, *a):
        pass


def main():
    port = int(conf("port", "47992") or 47992)
    bind = conf("bind", "loopback")
    host = "0.0.0.0" if bind == "lan" else "127.0.0.1"
    if bind == "lan" and not conf("token", ""):
        sys.stderr.write("[status] bind=lan needs a [status] token - refusing to start\n")
        sys.exit(1)
    srv = ThreadingHTTPServer((host, port), H)
    sys.stderr.write(f"yutsubasa status on http://{host}:{port}/  (bind={bind})\n")
    srv.serve_forever()


if __name__ == "__main__":
    main()
