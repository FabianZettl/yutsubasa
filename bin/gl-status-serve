.bar{{display:flex;gap:.5rem;align-items:center;margin:.6rem 0}}
.game input,.game select{{background:var(--bg);color:var(--tx);border:1px solid var(--bd);
border-radius:.35rem;padding:.28rem .4rem;font:inherit}}
.game .m{{width:9rem}}
</style></head><body>
<h1><b>yutsubasa</b> &nbsp;status</h1>
<p class=muted>auto-refresh 8s &middot; <span id=t></span></p>
<pre id=st>loading…</pre>
<h2>Library &middot; Steam · Lutris · Heroic</h2>
<div class=bar>
  <label><input type=checkbox id=direct checked> --direct</label>
  <label><input type=checkbox id=gs> --gamescope</label>
  <button class=sec id=reload>reload apps.json (restart :47989)</button>
</div>
<input id=gfilter placeholder="filter…" style="width:100%;margin:.3rem 0">
<div id=games class=muted>loading…</div>
<h2>Clients &middot; supersampling</h2>
<p class=muted>render the session above the device's resolution, transport at it (SSAA -
sharper, no extra bitrate/decode). matched on the resolution the device requests;
leave <b>match</b> to what only that device sends (e.g. <code>1280x720</code>).</p>
<div id=clients class=muted>loading…</div>
<script>
const TOKEN={token!r};
const q=(s)=>({{t:TOKEN}});
async function load(){{
 try{{
  document.getElementById('st').textContent=await (await fetch('api/status')).text();
  const gs=await (await fetch('api/games')).json();
