  const shown=gs.filter(g=>!f||g.name.toLowerCase().includes(f)||g.source.includes(f));
  document.getElementById('games').innerHTML = shown.length? shown.map(g=>
   `<div class=game><span class=n>${{g.name}}</span>`+
