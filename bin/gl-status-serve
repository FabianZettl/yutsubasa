#!/usr/bin/env python3
"""yutsubasa status + Steam-library control page.

A tiny stdlib HTTP server:
  GET  /                 themed status page (auto-refresh)
  GET  /api/status       plain `gaming-launcher status` + `troubleshoot`
  GET  /api/games        installed games (Steam, Lutris, Heroic) + which are added
  GET  /api/clients      paired devices + their supersampling settings
  POST /api/add-game     {id,name,direct,gamescope}  -> gaming-launcher add-game
                         id = steam:<appid> | lutris:<slug> | heroic:<appName>
  POST /api/client       {name,factor,match,enabled}    -> gaming-launcher clients
  POST /api/reload       restart sunshine-gaming so it reloads apps.json

Config: ~/.config/gaming-setup/gaming-setup.conf  [status]
  port  = 47992
  bind  = loopback | lan       (lan requires a token)
  token =                      (embedded in the page; required for lan)
"""
import html
import json
import os
import re
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config/gaming-setup/gaming-setup.conf")
APPS = os.path.join(HOME, ".config/gaming-setup/sunshine/apps.json")
CLIENTS_CONF = os.path.join(HOME, ".config/gaming-setup/clients.conf")
SUN_STATE = os.path.join(HOME, ".config/gaming-setup/sunshine/sunshine_state.json")
LAUNCHER = (
    "/usr/local/bin/gaming-launcher"
    if os.path.exists("/usr/local/bin/gaming-launcher")
    else os.path.join(HOME, ".local/bin/gaming-launcher")
)
STEAM_ROOTS = ["~/.local/share/Steam", "~/.steam/steam",
               "~/.var/app/com.valvesoftware.Steam/.steam/steam"]
ANSI = re.compile(r"\x1b\[[0-9;]*m")


def conf(key, default=""):
    try:
        with open(CONF) as f:
            sect = None
            for line in f:
                line = line.split("#", 1)[0].split(";", 1)[0].strip()
                m = re.match(r"\[(.+)\]$", line)
                if m:
                    sect = m.group(1); continue
                if sect == "status" and "=" in line:
                    k, v = (x.strip() for x in line.split("=", 1))
                    if k == key:
                        return v
    except OSError:
        pass
    return default


def sh(*args, timeout=30):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return (r.stdout or "") + (r.stderr or "")
    except (OSError, subprocess.SubprocessError) as e:
        return f"(command failed: {e})"


def steam_root():
    for r in STEAM_ROOTS:
        r = os.path.expanduser(r)
        if os.path.isdir(r):
            return r
    return None


def library_paths(root):
    vdf = os.path.join(root, "steamapps", "libraryfolders.vdf")
    paths = []
    try:
        txt = open(vdf, encoding="utf-8", errors="ignore").read()
        paths = re.findall(r'"path"\s+"([^"]+)"', txt)
    except OSError:
        pass
    return paths or [root]


def added_targets():
    """Every 'run <target>' argument already in apps.json, plus steam:<id> forms."""
    try:
        data = json.load(open(APPS))
    except (OSError, ValueError):
        return set()
    out = set()
    for a in data.get("apps", []):
        cmd = a.get("cmd", "")
        m = re.search(r"\brun\s+(\S+)", cmd)
        if m:
            tgt = m.group(1)
            out.add(tgt)
            if tgt.isdigit():
                out.add("steam:" + tgt)
        for sid in re.findall(r"(?:steam:|rungameid/)(\d+)", cmd):
            out.add("steam:" + sid)
    return out


def steam_games():
    root = steam_root()
    if not root:
        return []
    added = added_targets()
    seen, out = set(), []
    for lib in library_paths(root):
        d = os.path.join(lib, "steamapps")
        try:
            files = os.listdir(d)
        except OSError:
            continue
        for fn in files:
            if not fn.startswith("appmanifest_") or not fn.endswith(".acf"):
                continue
            try:
                t = open(os.path.join(d, fn), encoding="utf-8", errors="ignore").read()
            except OSError:
                continue
            am = re.search(r'"appid"\s+"(\d+)"', t)
            nm = re.search(r'"name"\s+"([^"]*)"', t)
            if not am:
                continue
            appid = am.group(1)
            if appid in seen:
                continue
            seen.add(appid)
            name = nm.group(1) if nm else appid
            low = name.lower()
            if low.startswith(("proton", "steam linux runtime", "steamworks common",
                               "steamvr", "steam controller")):
                continue
            gid = "steam:" + appid
            out.append({"id": gid, "appid": appid, "name": name, "source": "steam",
                        "added": gid in added or appid in added})
    out.sort(key=lambda g: g["name"].lower())
    return out


def lutris_games():
    db = os.path.join(HOME, ".local/share/lutris/pga.db")
    if not os.path.isfile(db):
        return []
    added = added_targets()
    out = []
    try:
        import sqlite3
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        rows = con.execute(
            "SELECT slug, name FROM games WHERE installed=1 AND slug IS NOT NULL AND slug<>''"
        ).fetchall()
        con.close()
    except Exception:
        return []
    for slug, name in rows:
        gid = "lutris:" + slug
        out.append({"id": gid, "name": name or slug, "source": "lutris",
                    "added": gid in added})
    out.sort(key=lambda g: g["name"].lower())
    return out


def _heroic_cfg():
    for p in (os.path.join(HOME, ".config/heroic"),
              os.path.join(HOME, ".var/app/com.heroicgameslauncher.hgl/config/heroic")):
        if os.path.isdir(p):
            return p
    return None


def heroic_games():
    cfg = _heroic_cfg()
    if not cfg:
        return []
    added = added_targets()
    found = {}  # appName -> title

    epic = os.path.join(cfg, "legendaryConfig/legendary/installed.json")
    try:
        d = json.load(open(epic))
        for k, v in d.items():
            found[k] = (v.get("title") or k) if isinstance(v, dict) else k
    except (OSError, ValueError):
        pass

    gog_inst = os.path.join(cfg, "gog_store/installed.json")
    try:
        inst = json.load(open(gog_inst)).get("installed", [])
        titles = {}
        try:
            libjson = json.load(open(os.path.join(cfg, "store_cache/gog_library.json")))
            games = libjson.get("games", libjson) if isinstance(libjson, dict) else libjson
            for g in (games or []):
                if isinstance(g, dict):
                    titles[str(g.get("app_name") or g.get("appName"))] = g.get("title")
        except (OSError, ValueError):
            pass
        for g in inst:
            an = str(g.get("appName"))
            found.setdefault(an, titles.get(an) or an)
    except (OSError, ValueError):
        pass

    for nile in (os.path.join(cfg, "nile_config/nile/installed.json"),):
        try:
            d = json.load(open(nile))
            items = d if isinstance(d, list) else d.get("installed", [])
            for g in items:
                an = str(g.get("id") or g.get("appName"))
                found.setdefault(an, g.get("name") or g.get("title") or an)
        except (OSError, ValueError):
            pass

    out = []
    for an, title in found.items():
        gid = "heroic:" + an
        out.append({"id": gid, "name": title or an, "source": "heroic",
                    "added": gid in added})
    out.sort(key=lambda g: g["name"].lower())
    return out


def library_games():
    return steam_games() + lutris_games() + heroic_games()


def status_text():
    return ANSI.sub("", sh(LAUNCHER, "status") + "\n" + sh(LAUNCHER, "troubleshoot"))


def _ini_sections(path):
    out, sect = {}, None
    try:
        for line in open(path):
            line = line.split("#", 1)[0].split(";", 1)[0].strip()
            m = re.match(r"\[(.+)\]$", line)
            if m:
                sect = m.group(1)
                out[sect] = {}
            elif sect and "=" in line:
                k, v = (x.strip() for x in line.split("=", 1))
                out[sect][k] = v
    except OSError:
        pass
    return out


def paired_names():
    try:
        d = json.load(open(SUN_STATE))
        devs = d.get("root", {}).get("named_devices", [])
    except (OSError, ValueError):
        return []
    return list(dict.fromkeys(x.get("name", "").strip()
                              for x in devs if x.get("name", "").strip()))


def clients_list():
    conf = _ini_sections(CLIENTS_CONF)
    paired = paired_names()
    out = []
    for n in dict.fromkeys(paired + list(conf)):
        c = conf.get(n, {})
        out.append({
            "name": n,
            "factor": c.get("factor", "1"),
            "match": c.get("match", ""),
            "enabled": c.get("enabled", "true").lower() != "false",
            "paired": n in paired,
        })
    return out


PAGE = """<!doctype html><html><head><meta charset=utf-8>
